{
  "openapi": "3.0.3",
  "info": {
    "title": "Waswa AI \u2014 Assistant & Console",
    "version": "Phase A (migration 041)"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:5000",
      "description": "Local \u2014 change to your API host"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/assistant/chat": {
      "post": {
        "summary": "Chat with Waswa",
        "tags": [
          "Waswa \u00b7 Chat"
        ],
        "description": "Any signed-in user. Returns reply, conversation_uid, message_uid (use it to flag), verified_answers, evidence, audience. surface: mobile | cms | console.",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Refused by a rule; message says why"
          },
          "401": {
            "description": "Not signed in"
          },
          "403": {
            "description": "Missing permission"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Wrong state for this action"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "type": "string"
                      },
                      "surface": {
                        "type": "string"
                      },
                      "conversation_uid": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "example": {
                "data": {
                  "message": "How do tracking tokens work?",
                  "surface": "mobile",
                  "conversation_uid": ""
                }
              }
            }
          }
        }
      }
    },
    "/assistant/feedback": {
      "post": {
        "summary": "Flag or rate an answer",
        "tags": [
          "Waswa \u00b7 Chat"
        ],
        "description": "Any signed-in user. verdict: wrong | unhelpful | good. Only on your own conversation unless you hold waswa.review.",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Refused by a rule; message says why"
          },
          "401": {
            "description": "Not signed in"
          },
          "403": {
            "description": "Missing permission"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Wrong state for this action"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "properties": {
                      "message_uid": {
                        "type": "string"
                      },
                      "verdict": {
                        "type": "string"
                      },
                      "note": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "example": {
                "data": {
                  "message_uid": "<from chat reply>",
                  "verdict": "wrong",
                  "note": "Explain how tokens work, not my balance"
                }
              }
            }
          }
        }
      }
    },
    "/assistant/context": {
      "get": {
        "summary": "What Waswa knows about me (diagnostic)",
