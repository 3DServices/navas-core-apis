    },
    "/assistant/knowledge": {
      "get": {
        "summary": "What document search returns (diagnostic)",
        "tags": [
          "Waswa \u00b7 Diagnostics"
        ],
        "description": "Any signed-in user. Uses the caller's audience, exactly as chat would.",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Refused by a rule; message says why"
          },
          "401": {
            "description": "Not signed in"
          },
          "403": {
            "description": "Missing permission"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Wrong state for this action"
          }
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Question to search; omit to list documents",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "include_unapproved",
            "in": "query",
            "required": false,
            "description": "true \u2014 reviewers only",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "product",
            "in": "query",
            "required": false,
            "description": "e.g. OLIWA",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "document_type",
            "in": "query",
            "required": false,
            "description": "procedure | strategy | user_stories | kpi",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
