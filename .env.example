# ============================================================
# NAVAS Core APIs — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
#
# Required variables (app will not start without these):
# ------------------------------------------------------------

DATABASE_URL=postgresql://user:password@host:5432/database_name
JWT_SECRET=replace-with-a-strong-random-secret-at-least-64-chars

# Optional variables (safe defaults are used if omitted):
# ------------------------------------------------------------

# BASE_URL=https://narvas.3dservices.co.ug/
# JWT_ACCESS_EXPIRY_MINUTES=30
# JWT_REFRESH_EXPIRY_DAYS=7
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://narvas.3dservices.co.ug,https://cms.3dservices.net

# Waswa AI Assistant (OpenRouter) — get a key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# OPENROUTER_MODEL=openai/gpt-4o
# OPENROUTER_SITE_URL=https://narvas.3dservices.co.ug/
# OPENROUTER_SITE_NAME=OLIWA Mobile

# Reverse geocoding (coords -> place names). Optional: without it the geocoder
# falls back to the free, rate-limited Nominatim service. Create a key in Google
# Cloud Console and enable the "Geocoding API" for it.
# GOOGLE_MAPS_API_KEY=your-google-geocoding-api-key

# Sign-in check on every route (endpoints/access_guard.py)
#   report  - let unsigned requests through but log "[auth-gate] would block ..." (default)
#   enforce - answer 401 to any request without a valid sign-in
AUTH_GATE_MODE=report
# Shared key for internal services that call the API without a user sign-in
# (alert engine -> /notifications/log, cron -> /pause/rules/run). Send it as X-Service-Key.
NAVAS_SERVICE_KEY=

# Geofence alerts (endpoints/alert_engine.py)
# Decide entries and exits on the server. Leave false and call POST /alerts/run
# from cron instead when the API runs with several workers.
ALERT_ENGINE_ENABLED=false
ALERT_ENGINE_INTERVAL_MINUTES=2
# A position older than this is treated as "we do not know where it is",
# not as a crossing.
ALERT_MAX_POSITION_AGE_DAYS=2
